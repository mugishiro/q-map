{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "infra/lambda/src",
    "outDir": "infra/lambda/dist",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "aws-lambda"],
    "lib": ["es2021", "DOM"]
  },
  "include": ["infra/lambda/src/**/*.ts"]
}
